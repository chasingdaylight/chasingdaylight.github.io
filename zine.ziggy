.zine_version = "0.14.1-dev",
.site = .simple(.{
    .title = "Chasing Daylight",
    .host_url = "https://chasingdaylight.dev",
    .content_dir_path = "content",
    .layouts_dir_path = "layouts",
    .assets_dir_path = "assets",
    .static_assets = [
        // the wordmark and avatar, at the addresses they always had
        "brand",
        // the icons tools/favicon.sh writes, at the site's root
        "favicon.ico",
        "icon-192.png",
        "apple-touch-icon.png",
        // the fonts 98.css loads from beside itself
        "vendor/98.css/ms_sans_serif.woff",
        "vendor/98.css/ms_sans_serif.woff2",
        "vendor/98.css/ms_sans_serif_bold.woff",
        "vendor/98.css/ms_sans_serif_bold.woff2",
    ],
}),
